{{- $items := slice -}}
{{- range .Pages -}}
  {{- $translatedLangs := slice -}}
  {{- range (default (slice) .Params.languages) -}}
    {{- $key := printf "lang_%s" . -}}
    {{- $translatedLangs = $translatedLangs | append (i18n $key | default .) -}}
  {{- end -}}
  {{- $translatedSubjects := slice -}}
  {{- range (default (slice) .Params.subjects) -}}
    {{- $subjKey := printf "subj_%s" (. | replaceRE " " "_" | replaceRE "&" "and" | replaceRE "'" "") -}}
    {{- $translatedSubjects = $translatedSubjects | append (i18n $subjKey | default .) -}}
  {{- end -}}
  {{- $item := dict
    "title" .Title
    "authors" (default (slice) .Params.authors)
    "year" (default 0 .Params.year)
    "decade" (default "" .Params.decade)
    "publishers" (default (slice) .Params.publishers)
    "place" (default "" .Params.place)
    "languages" $translatedLangs
    "item_types" (default (slice) .Params.item_types)
    "series" (default (slice) .Params.series)
    "subjects" $translatedSubjects
    "isbn" (default "" .Params.isbn)
    "pages" (default 0 .Params.pages)
    "cover" ((default "" .Params.cover) | relURL)
    "url" .RelPermalink
  -}}
  {{- $items = $items | append $item -}}
{{- end -}}
{{- $items | jsonify -}}
